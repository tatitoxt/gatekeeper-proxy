{
  "name": "gatekeeper-proxy",
  "version": "1.0.0",
  "description": "Dynamic reverse proxy with Rate Limiting and WAF Firewall rules in TypeScript/Node.js",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "demo:upstreams": "node scripts/demo-upstreams.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "npm run build && jest -c jest.e2e.config.json",
    "test:e2e:browser": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e && playwright test"
  },
  "keywords": [
    "reverse-proxy",
    "rate-limiting",
    "firewall",
    "waf",
    "typescript",
    "nodejs",
    "security"
  ],
  "author": "Fausto Pastura (@tatitoxt)",
  "license": "MIT",
  "dependencies": {
    "ip-range-check": "0.2.0",
    "pino": "9.14.0",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.58.2",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "ts-jest": "29.4.12",
    "tsx": "4.23.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  },
  "engines": {
    "node": ">=20"
  }
}
